 },
 {
  "type": "CarouselChoiceOptionData",
  "item_id": "0x0100008E00002CEC",
  "name_in_database": "Option_FocusPanel_MilitaryBranch_Navy",
  "path": "CarouselChoiceOptionProperties.Description",
  "ja": "艦砲射撃と水陸両用作戦に特化した先進的な軍艦を加えるべくリジア海軍へ投資すれば、海からの侵攻能力が大きく高まる。この戦略的拡充は海軍の存在感を押し上げ、専門の海兵部隊を一個加える。［予算-3、軍艦+1、潜水艦+1、海兵部隊+1］"
 },
 {
