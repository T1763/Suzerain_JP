 },
 {
  "type": "CarouselChoiceOptionData",
  "item_id": "0x0100008E00002CF3",
  "name_in_database": "Option_FocusPanel_MilitaryBranch_Army",
  "path": "CarouselChoiceOptionProperties.Description",
  "ja": "陸軍へ資源を振り向ければ、先進的な車両・火砲・歩兵装備によって地上作戦の幅が広がり、さらに山岳部隊を一個訓練できる。この方策は作戦上の潜在力を高め、陸上戦役により大きな柔軟性をもたらす。［予算-2、兵員+500、装備+500、山岳部隊+1］"
 },
 {
  "type": "CarouselChoiceOptionData",
