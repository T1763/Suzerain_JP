 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100008E00002CFC",
  "name_in_database": "Page_FocusPanel_EconomicStrategy",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "資源経済の強化に重点を置くなら、天然資源を活かし、長期のエネルギー契約を守ることになる。他方、資源依存を脱して経済を多角化する道は、均衡のとれた財政をめざし、過度な依存の危うさを和らげる。両者を織り交ぜる方策は、より大きな柔軟性をもたらす。"
 },
 {
