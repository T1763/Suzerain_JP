 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A22",
  "name_in_database": "Page_ReformistConstitution_Section1",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "第77条および第82条によれば、大統領は法案に文書を添えて議会へ差し戻すことで拒否権を行使できる。両条には拒否権を覆す方法についての定めがない。 \n\nその結果、大統領はソードランド大議会の特別多数をもってしても覆せない「絶対的」な拒否権を握っている。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A4F",
  "name_in_database": "Page_ReformistConstitution_Section2",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第2節：憲法改正の手続き"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A4F",
  "name_in_database": "Page_ReformistConstitution_Section2",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "憲法第5条によれば、150名以上の署名を得た改正案は大国民議会に提出することができる。改正には大国民議会における三分の二以上の賛成と、最高裁判所における単純過半数の賛成を要する。その結果、選挙で選ばれた立法府に属さない最高裁判所が議決権を持ち、改正手続きにおいて絶大な力を握っている。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A65",
  "name_in_database": "Page_ReformistConstitution_Section3",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第3節：大統領の弾劾"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A65",
  "name_in_database": "Page_ReformistConstitution_Section3",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "第17条によれば、ソードランド大統領は、大逆罪または憲法違反の場合を除き、大統領としての職務の遂行にあたって行った行為について責任を負わない。これらの場合には、最高裁判所が合同法廷において構成員の絶対多数をもって大統領を弾劾することができる。 \n\nしたがって弾劾の手続きには最高裁判所のみが関与し、同裁判所は行政府に対して大きな力を持つことになる。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A89",
  "name_in_database": "Page_ReformistConstitution_Section4",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第4節：閣僚の任命"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013A89",
  "name_in_database": "Page_ReformistConstitution_Section4",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "憲法によれば、大統領は議会で選出された議員のなかから閣僚会議の閣僚を任命する。\n\n「大統領は閣僚を指名することができ、その任命には大国民議会の信任投票を要する」という一文を加えて信任投票を導入することもできるし、「大国民議会は閣僚の名簿を指名することができ、大統領はそこから任命することができる」として議会の関与をより強めることもできる。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013AB0",
  "name_in_database": "Page_ReformistConstitution_Section5",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第5節：議席獲得ライン"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013AB0",
  "name_in_database": "Page_ReformistConstitution_Section5",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "第50条によれば、政党が大国民議会で議席を得るには全国総得票の10%以上を要する。このラインを越えた政党の得票は比例して再配分されるため、現在首位にあるUSPが最大の恩恵を受けることになる。\n\nラインを下げれば、次の選挙でブルディア労働者党やソードランド共産党が議席を得るかもしれない。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013AD3",
  "name_in_database": "Page_ReformistConstitution_Section6",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第6節：大統領令"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013AD3",
  "name_in_database": "Page_ReformistConstitution_Section6",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "第18条および第51条によれば、大統領は政治・社会・経済の事項について法律と同一の効力を持つ命令を発することができる。ただしそれは憲法に反してはならず、司法審査の対象となる。 \n\nしたがって大統領は、多くの事項について大国民議会を経ずに命令を発することができる。もっとも議会は、同じ事項について法律を可決して大統領令を覆すことができる。命令を発するには議会の授権法を要するものとして議会を手続きに関与させることも、大統領令を完全に廃して議会を唯一の立法機関とすることもできる。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013AF3",
  "name_in_database": "Page_ReformistConstitution_Section7",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第7節：任期の制限"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013AF3",
  "name_in_database": "Page_ReformistConstitution_Section7",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "憲法によれば、大統領は4年の任期で選出される。しかし任期の制限については何ら定めがなく、一個人が無制限に立候補し、当選し、大統領を務めることが可能になっている。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013B11",
  "name_in_database": "Page_ReformistConstitution_Section8",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第8節：判事の免責"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013B11",
  "name_in_database": "Page_ReformistConstitution_Section8",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "憲法は最高裁判事に法の前の絶対的免責を与え、弾劾の手続きを何ら定めていない。そのため判事は他の統治機構が手を触れられない存在となっている。\n\n違憲な行為という法的理由に基づいて判事の弾劾を発議する権利を大国民議会に与え、弾劾の手続きを定めることができる。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013B29",
  "name_in_database": "Page_ReformistConstitution_Section9",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "第9節：タルキン・ソルの「名誉議員」としての権利"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005100013B29",
  "name_in_database": "Page_ReformistConstitution_Section9",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "憲法第99条は「名誉議員」の称号と、その者が行使しうる権利を定めている。名誉議員は絶対的免責を有し、大国民議会の終身議員とみなされる。国家の大統領警護隊から提供される専属の警護班を自ら統率する権限を与えられる。また、国家が無償で用意する特別な私邸に住む資格も持つ。 \n\nこの称号を有する者は、タルキン・ソルただ一人である。"
 },
 {
