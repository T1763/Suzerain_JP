 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100008E00002CA2",
  "name_in_database": "Page_FocusPanel_ForeignStrategy",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "王国は新たな外交上の選択に直面している。介入主義は積極的な軍事関与を促し、宥和はヴェーレンおよびルンブルク王室との結びつきを強めることをめざす。あるいは第三の道を選び、デルディア・パレス・モレラと地域同盟を結んで大国との関わりを避けることもできる。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100008E00002CBF",
  "name_in_database": "Page_FocusPanel_GovernmentIntention",
  "path": "MultipleChoicePageProperties.Title",
