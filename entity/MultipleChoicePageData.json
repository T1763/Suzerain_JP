 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x010000640000C5F1",
  "name_in_database": "Page_WehlenNegotiationPromises_Section3",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "対反乱作戦への支援［公約］"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x010000640000C5F1",
  "name_in_database": "Page_WehlenNegotiationPromises_Section3",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "ヴェーレンは、ブルディア自由戦線に対する将来の支援をリジアが約束するよう求めている。具体的には、BFFの反乱分子が南へ逃れる余地をなくすため、クレレック海峡に艦船を派遣することである。"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x010000520001C5BA",
  "name_in_database": "Page_WehlenNegotiationPromises_Section4",
  "path": "MultipleChoicePageProperties.Title",
  "ja": "テロ対策のための国境管理"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x010000520001C5BA",
  "name_in_database": "Page_WehlenNegotiationPromises_Section4",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "ヴェーレンは、ブルディア自由戦線の構成員がリジア国境を越えるのを防ぐ新たな措置を提案している。デルディアの旅券保持者およびブルディアの身分証明書を持つ者について、我が国の国境警備隊が入国を禁じるよう求めるものである。［国境警備隊を拡充していれば負担なし］"
 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x010000520001C5B6",
