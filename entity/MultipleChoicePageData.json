 },
 {
  "type": "MultipleChoicePageData",
  "item_id": "0x0100005D000004CE",
  "name_in_database": "Page_PromisesPanel_Diplomacy",
  "path": "MultipleChoicePageProperties.Subtitle",
  "ja": "西の資本主義国アルカシア、北の君主国ルンブルク、東の共産主義国コンタナ連邦――この三者の世界規模の角逐は激しさを増している。ソードランドはいずれかと手を結ぶことも、中立へ傾くこともできる。"
 },
 {
